---
import wordsData from '../data/words.json';
import '../styles/global.css';

const title = "English Plural Words Dictionary";

// Extract unique types/categories for filter buttons
const categories = ["all", ...new Set(wordsData.map((item) => item.type).filter(Boolean))];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Prevent theme flicker before page load -->
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 font-['Inter',sans-serif] min-h-screen flex flex-col antialiased transition-colors duration-200">
    
    <!-- Navbar -->
    <header class="border-b border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/80 backdrop-blur sticky top-0 z-30">
      <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center text-white font-bold text-lg shadow-sm">
            S
          </div>
          <span class="font-bold text-slate-900 dark:text-white text-lg tracking-tight">Singular<span class="text-indigo-600 dark:text-indigo-400">Plural</span></span>
        </div>

        <div class="flex items-center gap-3">

          <!-- Word Count Badge -->
          <span class="text-xs font-semibold px-2.5 py-1 bg-indigo-50 dark:bg-indigo-950/60 text-indigo-700 dark:text-indigo-300 rounded-full border border-indigo-100 dark:border-indigo-900/60">
            {wordsData.length} Words Loaded
          </span>

          <!-- Dark Mode Toggle Button -->
          <button 
            type="button" 
            id="themeToggle" 
            class="p-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 transition"
            title="Toggle theme"
            aria-label="Toggle dark mode"
          >
            <!-- Sun Icon (Shows in dark mode) -->
            <svg id="sunIcon" class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <!-- Moon Icon (Shows in light mode) -->
            <svg id="moonIcon" class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Hero & Search Section -->
    <main class="max-w-6xl mx-auto px-4 py-10 flex-1 w-full">
      <div class="text-center max-w-2xl mx-auto mb-8">
        <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-3">
          Master English <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-violet-600 dark:from-indigo-400 dark:to-violet-400">Plural Forms</span>
        </h1>
        <p class="text-slate-600 dark:text-slate-400 text-sm sm:text-base">
          A simple helping tool to learn, search, and listen to English singular and plural forms.
          <br />
          (I know you get confused about plural words in IELTS Listening)
        </p>

        <!-- Words of Gratitude Button -->
<div class="mt-5">
  <button
    type="button"
    id="gratitudeBtn"
    class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl
           bg-indigo-600 hover:bg-indigo-700
           text-white text-sm font-semibold
