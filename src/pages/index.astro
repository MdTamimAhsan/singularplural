---
import '../styles/global.css';
import wordsData from '../data/words.json';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>English Singular & Plural Pairs (US & UK Audio)</title>
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen p-4 sm:p-6 font-sans">
  <div class="max-w-5xl mx-auto">
    
    <!-- Header -->
    <header class="text-center mb-8">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-800 tracking-tight">
        English Singular & Plural Pairs
      </h1>
      <p class="text-slate-600 mt-2 text-sm sm:text-base">
        Listen in both American and British accents, compare pronunciation, and master noun forms.
      </p>
      
      <!-- Search & Filters -->
      <div class="mt-6 flex flex-col sm:flex-row gap-3 justify-center items-center max-w-2xl mx-auto">
        <div class="relative w-full sm:w-2/3">
          <input 
            type="text" 
            id="searchInput" 
            placeholder="Search singular or plural word..." 
            class="w-full px-4 py-2.5 rounded-xl border border-slate-300 shadow-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition bg-white"
          />
        </div>
        
        <select 
          id="typeFilter" 
          class="w-full sm:w-1/3 px-4 py-2.5 rounded-xl border border-slate-300 shadow-sm bg-white focus:ring-2 focus:ring-indigo-500 outline-none transition cursor-pointer"
        >
          <option value="all">All Types</option>
          <option value="regular">Regular (-s, -es, -ies)</option>
          <option value="irregular">Irregular</option>
          <option value="uncountable">Uncountable</option>
        </select>
      </div>

      <p id="resultCount" class="text-xs text-slate-500 mt-3 font-medium"></p>
    </header>

    <!-- Word Grid Container -->
    <div id="wordGrid" class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>

    <!-- Empty State -->
    <div id="emptyState" class="hidden text-center py-12">
      <p class="text-slate-400 text-lg">No matching words found.</p>
    </div>

    <!-- Pagination Controls -->
    <div id="pagination" class="mt-8 flex justify-center items-center gap-4">
      <button 
        id="prevBtn" 
        class="px-4 py-2 bg-white border border-slate-300 rounded-lg text-sm font-semibold hover:bg-slate-100 disabled:opacity-40 disabled:cursor-not-allowed transition cursor-pointer"
      >
        ← Previous
      </button>
      <span id="pageInfo" class="text-sm font-medium text-slate-600"></span>
      <button 
        id="nextBtn" 
        class="px-4 py-2 bg-white border border-slate-300 rounded-lg text-sm font-semibold hover:bg-slate-100 disabled:opacity-40 disabled:cursor-not-allowed transition cursor-pointer"
      >
        Next →
      </button>
    </div>

  </div>

  <!-- Client-Side Engine (Dual Accent Speech, Search, Pagination) -->
  <script define:vars={{ wordsData }}>
    const ITEMS_PER_PAGE = 50;
    let currentPage = 1;
    let filteredWords = [...wordsData];
    let availableVoices = [];

    const searchInput = document.getElementById('searchInput');
    const typeFilter = document.getElementById('typeFilter');
    const wordGrid = document.getElementById('wordGrid');
    const emptyState = document.getElementById('emptyState');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    const pageInfo = document.getElementById('pageInfo');
    const resultCount = document.getElementById('resultCount');

    // Cache browser voices
    function loadVoices() {
      if ('speechSynthesis' in window) {
        availableVoices = window.speechSynthesis.getVoices();
      }
    }
    loadVoices();
    if ('speechSynthesis' in window && window.speechSynthesis.onvoiceschanged !== undefined) {
      window.speechSynthesis.onvoiceschanged = loadVoices;
    }

    // Dual-accent Speech Synthesis
    function playWord(text, accent = 'en-US') {
      if (!text || !('speechSynthesis' in window)) return;
      window.speechSynthesis.cancel(); // Stop any currently playing audio

      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = accent;
      utterance.rate = 0.85; // Slightly slower for clear learning

      // Match best system voice for US vs UK if available
      const voice = availableVoices.find(v => v.lang.replace('_', '-').startsWith(accent));
      if (voice) {
        utterance.voice = voice;
      }

      window.speechSynthesis.speak(utterance);
    }

    // Filter Logic
    function filterData() {
      const query = searchInput.value.trim().toLowerCase();
      const type = typeFilter.value;

      filteredWords = wordsData.filter(item => {
        const matchesQuery = 
          item.singular.toLowerCase().includes(query) || 
          (item.plural && item.plural.toLowerCase().includes(query));

        const matchesType = (type === 'all') || (item.type === type);

        return matchesQuery && matchesType;
      });

      currentPage = 1;
      render();
    }

    // Render Cards
    function render() {
      const totalPages = Math.ceil(filteredWords.length / ITEMS_PER_PAGE) || 1;
      const startIdx = (currentPage - 1) * ITEMS_PER_PAGE;
      const paginatedItems = filteredWords.slice(startIdx, startIdx + ITEMS_PER_PAGE);

      resultCount.textContent = `Showing ${filteredWords.length} words`;

      if (paginatedItems.length === 0) {
        wordGrid.innerHTML = '';
        emptyState.classList.remove('hidden');
        document.getElementById('pagination').classList.add('hidden');
        return;
      }

      emptyState.classList.add('hidden');
      document.getElementById('pagination').classList.remove('hidden');

      wordGrid.innerHTML = paginatedItems.map(item => `
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between hover:shadow-md transition">
          
          <!-- Singular -->
          <div class="flex-1 text-center border-r border-slate-100 pr-3">
            <span class="text-[11px] uppercase font-bold text-slate-400 tracking-wider">Singular</span>
            <p class="text-2xl font-extrabold text-slate-800 mt-1">${item.singular}</p>
            <p class="text-xs font-mono text-slate-500 mt-1">${item.singular_ipa || ''}</p>
            
            <div class="flex justify-center gap-1.5 mt-3">
              <button 
                onclick="window.__playWord('${item.singular}', 'en-US')"
                class="px-2.5 py-1 bg-indigo-50 hover:bg-indigo-100 active:scale-95 text-indigo-700 text-xs font-semibold rounded-lg transition cursor-pointer"
                title="Play US Accent"
              >
                🇺🇸 US
              </button>
              <button 
                onclick="window.__playWord('${item.singular}', 'en-GB')"
                class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 active:scale-95 text-slate-700 text-xs font-semibold rounded-lg transition cursor-pointer"
                title="Play UK Accent"
              >
                🇬🇧 UK
              </button>
            </div>
          </div>

          <!-- Plural -->
          <div class="flex-1 text-center pl-3">
            <span class="text-[11px] uppercase font-bold text-slate-400 tracking-wider">Plural</span>
            ${item.plural ? `
              <p class="text-2xl font-extrabold text-indigo-600 mt-1">${item.plural}</p>
              <p class="text-xs font-mono text-slate-500 mt-1">${item.plural_ipa || ''}</p>
              
              <div class="flex justify-center gap-1.5 mt-3">
                <button 
                  onclick="window.__playWord('${item.plural}', 'en-US')"
                  class="px-2.5 py-1 bg-indigo-50 hover:bg-indigo-100 active:scale-95 text-indigo-700 text-xs font-semibold rounded-lg transition cursor-pointer"
                  title="Play US Accent"
                >
                  🇺🇸 US
                </button>
                <button 
                  onclick="window.__playWord('${item.plural}', 'en-GB')"
                  class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 active:scale-95 text-slate-700 text-xs font-semibold rounded-lg transition cursor-pointer"
                  title="Play UK Accent"
                >
                  🇬🇧 UK
                </button>
              </div>
            ` : `
              <p class="text-sm italic text-slate-400 mt-3">No plural form</p>
              <span class="inline-block mt-3 px-2 py-0.5 bg-amber-50 text-amber-700 text-xs font-medium rounded">Uncountable</span>
            `}
          </div>

        </div>
      `).join('');

      pageInfo.textContent = `Page ${currentPage} of ${totalPages}`;
      prevBtn.disabled = currentPage === 1;
      nextBtn.disabled = currentPage >= totalPages;
    }

    window.__playWord = playWord;

    searchInput.addEventListener('input', filterData);
    typeFilter.addEventListener('change', filterData);

    prevBtn.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        render();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });

    nextBtn.addEventListener('click', () => {
      const totalPages = Math.ceil(filteredWords.length / ITEMS_PER_PAGE);
      if (currentPage < totalPages) {
        currentPage++;
        render();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });

    render();
  </script>
</body>
</html>