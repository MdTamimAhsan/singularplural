---
// Import your words data
import wordsData from '../data/words.json';

// Import Tailwind CSS
import '../styles/global.css';

// Page title and metadata
const title = "English Plural Words Dictionary";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-slate-50 text-slate-900 font-['Inter',sans-serif] min-h-screen flex flex-col antialiased">
    
    <!-- Navbar / Header -->
    <header class="border-b border-slate-200 bg-white/80 backdrop-blur sticky top-0 z-30">
      <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center text-white font-bold text-lg shadow-sm">
            S
          </div>
          <span class="font-bold text-slate-900 text-lg tracking-tight">SingularPlural</span>
        </div>
        <span class="text-xs font-semibold px-2.5 py-1 bg-indigo-50 text-indigo-700 rounded-full border border-indigo-100">
          {wordsData.length} Words Loaded
        </span>
      </div>
    </header>

    <!-- Hero Section -->
    <main class="max-w-6xl mx-auto px-4 py-12 flex-1 w-full">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight mb-4">
          Master English <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-violet-600">Plural Forms</span>
        </h1>
        <p class="text-slate-600 text-base sm:text-lg">
          Search irregular plurals, regular rules, and edge cases instantly.
        </p>

        <!-- Search Bar -->
        <div class="mt-8 relative max-w-xl mx-auto">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
            <svg class="w-5 h-5" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
          <input 
            type="text" 
            id="searchInput"
            placeholder="Search singular or plural word (e.g. cactus, child)..." 
            class="w-full pl-11 pr-4 py-3.5 bg-white border border-slate-300 rounded-2xl shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition text-slate-800 placeholder-slate-400"
          />
        </div>
      </div>

      <!-- Word Cards Grid -->
      <div id="wordGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {wordsData.map((item) => (
          <div class="word-card bg-white p-5 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md hover:border-indigo-200 transition-all group flex flex-col justify-between"
               data-singular={item.singular?.toLowerCase()} 
               data-plural={item.plural?.toLowerCase()}>
            <div>
              <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Singular</span>
              <p class="text-xl font-bold text-slate-800 group-hover:text-indigo-600 transition-colors">
                {item.singular}
              </p>
            </div>
            
            <div class="mt-4 pt-3 border-t border-slate-100 flex items-baseline justify-between">
              <div>
                <span class="text-[11px] font-semibold uppercase tracking-wider text-indigo-500">Plural</span>
                <p class="text-lg font-semibold text-slate-900">
                  {item.plural}
                </p>
              </div>
              {item.type && (
                <span class="text-[10px] px-2 py-0.5 bg-slate-100 text-slate-600 rounded-md font-medium">
                  {item.type}
                </span>
              )}
            </div>
          </div>
        ))}
      </div>

      <!-- Empty Search Fallback -->
      <div id="noResults" class="hidden text-center py-16">
        <p class="text-slate-400 text-lg">No matching words found.</p>
      </div>
    </main>

    <!-- Client-side Instant Search -->
    <script>
      const searchInput = document.getElementById('searchInput');
      const cards = document.querySelectorAll('.word-card');
      const noResults = document.getElementById('noResults');

      searchInput?.addEventListener('input', (e) => {
        const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
        let visibleCount = 0;

        cards.forEach((card) => {
          const singular = card.getAttribute('data-singular') || '';
          const plural = card.getAttribute('data-plural') || '';
          const match = singular.includes(query) || plural.includes(query);

          if (match) {
            (card as HTMLElement).style.display = 'flex';
            visibleCount++;
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });

        if (noResults) {
          noResults.style.display = visibleCount === 0 ? 'block' : 'none';
        }
      });
    </script>
  </body>
</html>