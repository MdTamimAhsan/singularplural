// Speech Synthesis Audio Engine
// Robust Multi-Browser Accent Engine
async function speakWord(text: string, lang: string) {
  if (!('speechSynthesis' in window)) return;

  window.speechSynthesis.cancel();
  const targetCode = lang.replace('_', '-').toLowerCase();
  const voices = window.speechSynthesis.getVoices();

  // Check if browser has a native Australian or British voice installed
  const hasDistinctNativeVoice = voices.some((v) => {
    const vLang = v.lang.replace('_', '-').toLowerCase();
    if (targetCode.includes('au')) {
      return vLang === 'en-au' || /australia|australian|karen|natasha|catherine|lee/i.test(v.name);
    }
    if (targetCode.includes('gb')) {
      return vLang === 'en-gb' || /uk|british|great britain|george|hazel|susan|oliver/i.test(v.name);
    }
    return false;
  });

  // If testing AU or GB and no native voice exists on this machine, use the Dictionary API
  if ((targetCode.includes('au') || targetCode.includes('gb')) && !hasDistinctNativeVoice) {
    try {
      const cleanWord = text.trim().toLowerCase().split(' ')[0]; // handles single terms or compounds
      const response = await fetch(`https://api.dictionaryapi.dev/api/v2/entries/en/${encodeURIComponent(cleanWord)}`);
      
      if (response.ok) {
        const data = await response.json();
        if (Array.isArray(data) && data[0]?.phonetics?.length > 0) {
          const regionTag = targetCode.includes('au') ? 'au' : 'uk';
          
          // Match region-specific audio recording
          const phonetic = data[0].phonetics.find((p: any) => p.audio && p.audio.toLowerCase().includes(`-${regionTag}.mp3`))
                        || data[0].phonetics.find((p: any) => p.audio && p.audio.length > 0);

          if (phonetic?.audio) {
            const audio = new Audio(phonetic.audio);
            await audio.play();
            return;
          }
        }
      }
    } catch {
      // Fallback seamlessly to native synthesis if network request fails
    }
  }

  // Native Speech Synthesis Fallback
  const utterance = new SpeechSynthesisUtterance(text);
  utterance.lang = lang;
  utterance.rate = 0.88;

  let matchedVoice = voices.find((v) => v.lang.replace('_', '-').toLowerCase() === targetCode);

  if (!matchedVoice) {
    if (targetCode.includes('au')) {
      matchedVoice = voices.find((v) => /australia|australian|karen|natasha|catherine|lee/i.test(v.name));
    } else if (targetCode.includes('gb')) {
      matchedVoice = voices.find((v) => /uk|british|great britain|george|hazel|susan|oliver/i.test(v.name));
    } else if (targetCode.includes('us')) {
      matchedVoice = voices.find((v) => /us|united states|american|david|zira|mark/i.test(v.name));
    }
  }

  if (matchedVoice) {
    utterance.voice = matchedVoice;
  }

  window.speechSynthesis.speak(utterance);
}

      if ('speechSynthesis' in window) {
        window.speechSynthesis.onvoiceschanged = () => {
          window.speechSynthesis.getVoices();
        };
      }
      // Audio click handler
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('.speak-btn');
        if (!btn) return;

        const word = btn.getAttribute('data-word');
        const lang = btn.getAttribute('data-lang') || 'en-US';

        if (word) {
          speakWord(word, lang);
        }
      });

// Filter, Search & Pagination Engine
const searchInput = document.getElementById('searchInput') as HTMLInputElement | null;
const cards = Array.from(document.querySelectorAll('.word-card')) as HTMLElement[];
const filterButtons = document.querySelectorAll('.filter-btn');
const noResults = document.getElementById('noResults');

const prevPage = document.getElementById('prevPage') as HTMLButtonElement | null;
const nextPage = document.getElementById('nextPage') as HTMLButtonElement | null;
const pageInfo = document.getElementById('pageInfo');
const pagination = document.getElementById('pagination');
const wordGrid = document.getElementById('wordGrid');

let currentCategory = 'all';
let currentPage = 1;

const wordsPerPage = 24;


// Get the cards that match search + filter
function getMatchingCards() {
  const query = searchInput?.value.toLowerCase().trim() || '';

  return cards.filter((card) => {
    const singular = card.getAttribute('data-singular') || '';
    const plural = card.getAttribute('data-plural') || '';
    const type = card.getAttribute('data-type') || '';

    const matchesQuery =
      !query ||
      singular.includes(query) ||
      plural.includes(query);

    const matchesCategory =
      currentCategory === 'all' ||
      type === currentCategory;

    return matchesQuery && matchesCategory;
  });
}


// Show only the current page
function renderPage() {
  const matchingCards = getMatchingCards();

  const totalPages = Math.max(
    1,
    Math.ceil(matchingCards.length / wordsPerPage)
  );

  if (currentPage > totalPages) {
    currentPage = totalPages;
  }

  // Hide all cards first
  cards.forEach((card) => {
    card.style.display = 'none';
  });

  // Decide which cards belong to this page
  const start = (currentPage - 1) * wordsPerPage;
  const end = start + wordsPerPage;

  matchingCards.slice(start, end).forEach((card) => {
    card.style.display = 'flex';
  });

  // No results message
  if (noResults) {
    noResults.style.display =
      matchingCards.length === 0 ? 'block' : 'none';
  }

  // Hide pagination if there are no results
  if (pagination) {
    pagination.style.display =
      matchingCards.length === 0 ? 'none' : 'flex';
  }

  // Show page number
  if (pageInfo) {
    pageInfo.textContent =
      `Page ${currentPage} of ${totalPages}`;
  }

  // Previous button
  if (prevPage) {
    prevPage.disabled = currentPage === 1;
  }

  // Next button
  if (nextPage) {
    nextPage.disabled = currentPage === totalPages;
  }
}


// Search box
searchInput?.addEventListener('input', () => {
  currentPage = 1;
  renderPage();
});


// Filter buttons
filterButtons.forEach((btn) => {
  btn.addEventListener('click', () => {

    filterButtons.forEach((b) => {
      b.classList.remove(
        'bg-indigo-600',
        'text-white',
        'border-indigo-600'
      );

      b.classList.add(
        'bg-white',
        'dark:bg-slate-900',
        'text-slate-600',
        'dark:text-slate-300',
        'border-slate-200',
        'dark:border-slate-800'
      );
    });

    btn.classList.remove(
      'bg-white',
      'dark:bg-slate-900',
      'text-slate-600',
      'dark:text-slate-300',
      'border-slate-200',
      'dark:border-slate-800'
    );

    btn.classList.add(
      'bg-indigo-600',
      'text-white',
      'border-indigo-600'
    );

    currentCategory =
      (btn.getAttribute('data-category') || 'all').toLowerCase();

    currentPage = 1;
    renderPage();
  });
});


// Previous page
prevPage?.addEventListener('click', () => {
  if (currentPage > 1) {
    currentPage--;
    renderPage();

    wordGrid?.scrollIntoView({
      behavior: 'smooth'
    });
  }
});


// Next page
nextPage?.addEventListener('click', () => {
  const matchingCards = getMatchingCards();

  const totalPages = Math.ceil(
    matchingCards.length / wordsPerPage
  );

  if (currentPage < totalPages) {
    currentPage++;
    renderPage();

    wordGrid?.scrollIntoView({
      behavior: 'smooth'
    });
  }
});


// Load page 1 when the website starts
renderPage();
    </script>
  </body>
</html>